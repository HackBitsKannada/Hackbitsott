# ===== PUBLIC (safe in browser; protected by Row Level Security) =====
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== SERVER-ONLY (never prefix with NEXT_PUBLIC_, never put in Android) =====
# Used only by the admin app's server code and Supabase Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign short-lived playback tokens (Edge Function secret).
# Generate with: openssl rand -base64 48
PLAYBACK_TOKEN_SECRET=change-me

# Licensed video provider (filled in during Phase 7; provider-specific)
VIDEO_PROVIDER=demo
